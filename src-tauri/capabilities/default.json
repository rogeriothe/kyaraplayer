{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Player windows",
  "windows": [
    "main",
    "equalizer",
    "playlist",
    "openurl",
    "fileinfo"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "dialog:allow-open",
    "core:window:allow-set-size",
    "dialog:allow-save"
  ]
}
